{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metroventure-city",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Always claim a *.workers.dev address. Without this a deploy can succeed and
  // still leave the Worker with "No URLs enabled", which looks exactly like a
  // broken deploy from the game's side.
  "workers_dev": true,

  // One Durable Object per city/room. SQLite-backed DOs are available on the
  // Workers Free plan; every new DO class must be declared in a migration.
  "durable_objects": {
    "bindings": [
      { "name": "CITY_ROOM", "class_name": "CityRoom" },
      // Global accounts + cloud saves: one object, so identity and wallets
      // survive when the world is sharded into district rooms.
      { "name": "ACCOUNTS", "class_name": "AccountHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CityRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountHub"] }
  ],

  "observability": { "enabled": true },

  // Uncomment after `wrangler dev` works locally:
  //
  // "vars": {
  //   "ALLOWED_ORIGINS": "https://easypay-ng.github.io,http://localhost:8080"
  // }
}
